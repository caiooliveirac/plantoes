        "@radix-ui/react-tooltip": "^1.2.14",
        "bcryptjs": "^3.0.3",
        "cmdk": "^1.1.1",
        "drizzle-orm": "^0.45.2",
        "exceljs": "^4.4.0",
        "framer-motion": "^12.42.2",
        "lucide-react": "^1.26.0",
        "next": "16.2.11",
        "next-auth": "^5.0.0-beta.30",
        "postgres": "^3.4.9",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "sonner": "^2.0.7",
        "tsx": "^4.23.1",
        "zod": "^4.4.3"
