{
    "name": "operations-v2",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next typegen && tsc --noEmit -p tsconfig.deploy.json",
        "typecheck": "next typegen && tsc --noEmit -p tsconfig.deploy.json",
        "test:deploy": "node --test --import tsx $(find tests -name '*.test.ts' ! -name 'telegram-meal-breaks.test.ts' -print)",
        "test:full": "node --test --import tsx tests/**/*.test.ts",
        "test": "node --test --import tsx tests/**/*.test.ts",
        "bank-hours:rebuild": "tsx scripts/rebuild-bank-hours.ts",
        "bank-hours:legacy:matching-report": "tsx scripts/report-legacy-bank-hours-matching.ts",
        "bank-hours:legacy:seed": "tsx scripts/seed-legacy-bank-hours.ts",
        "regulation:arrival": "tsx scripts/register-regulation-arrival.ts",
        "scheduled-windows:repair": "tsx scripts/repair-scheduled-windows.ts",
        "telegram:continuity:repair": "tsx scripts/repair-telegram-continuity.ts",
        "telegram:review-inputs": "tsx scripts/list-telegram-review-inputs.ts",
        "telegram:suggestions": "tsx scripts/list-telegram-command-suggestions.ts",
        "db:migrate": "tsx scripts/apply-migrations.ts",
        "db:import-doctors": "tsx scripts/import-doctors.ts",
        "telegram:worker": "node --import tsx scripts/telegram-reminder-worker.ts",
        "runtime:guard-check": "bash scripts/runtime-guard-check.sh",
        "provision:initial-access": "tsx scripts/provision-initial-access.ts",
        "deploy:production": "bash scripts/deploy-production.sh"
