# Cutoff FASE 1 -> FASE 2 do registro de chegada (instante ISO no fuso de Salvador/BR).
# Antes do cutoff: registra horario declarado + avisa. A partir do cutoff: registra so o timestamp da msg.
# Ausente => FASE 1 (comportamento atual).
ARRIVAL_TIME_CUTOFF=2026-06-01T00:00:00-03:00

# Escala externa (app escala.mnrs.com.br) — "aguardando fulano" no quadro.
# Sem ESCALA_API_URL o quadro ignora a integração (fail-soft).
ESCALA_API_URL=https://escala.mnrs.com.br
ESCALA_API_TOKEN=
