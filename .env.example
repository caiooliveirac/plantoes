DATABASE_URL=postgres://plantoes:plantoes@127.0.0.1:5432/plantoes?options=-csearch_path%3Doperations_v2
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_IDS=
TELEGRAM_PRIVATE_CONTROL_USER_IDS=
TELEGRAM_CHIEF_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Poll de 30s permite cobranças de meal-break a cada 90s.
TELEGRAM_REMINDER_POLL_MS=30000
# Cutoff FASE 1 -> FASE 2 do registro de chegada (instante ISO no fuso de Salvador/BR).
# Antes do cutoff: registra horario declarado + avisa. A partir do cutoff: registra so o timestamp da msg.
# Ausente => FASE 1 (comportamento atual).
ARRIVAL_TIME_CUTOFF=2026-06-01T00:00:00-03:00

# Escala externa (app escala.mnrs.com.br) — "aguardando fulano" no quadro.
# Sem ESCALA_API_URL o quadro ignora a integração (fail-soft).
ESCALA_API_URL=https://escala.mnrs.com.br
ESCALA_API_TOKEN=

# Painel de vagas (app /tabela, mesmo servidor) — UPAs restritas pela chefia na
# chegada do regulador e no /upas. Sem isso, a chegada sai sem o bloco (fail-soft).
# O aviso PERIÓDICO dessas restrições é do bot regulador, que vive no repo tabela.
TABELA_API_URL=http://127.0.0.1:3001/tabela/api

# Email transacional via SMTP do Gmail (código de cadastro do médico e link de
# "esqueci a senha"). GMAIL_SMTP_APP_PASSWORD é uma App Password (conta Google com
# 2FA > Senhas de app), NUNCA a senha da conta. Sem as duas, cadastro por email
# responde 503 e o reset volta a ser manual (fail-soft).
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Opcional: remetente exibido (default "Plantões SAMU <GMAIL_SMTP_USER>").
EMAIL_FROM=

# Banco de horas — resumo diário de pendências (±12h) no privado dos admins e
# aviso ao médico quando um acerto é lançado/estornado. Feature flag: precisa
# ser "1" (ou "true") para o bot enviar; desligada, os acertos continuam
# funcionando e visíveis na aplicação, só não sai Telegram.
BANK_HOURS_PENDING_ALERTS_ENABLED=

# --- Verificação de credencial para o Escalas & Trocas (app irmão) -----------
# Portão da rota POST /api/auth/verificar-escala, que responde apenas "esta
# senha vale?" para o processo do escala — servidor↔servidor, nunca pelo
# navegador. Nenhum hash sai daqui e nenhuma conta é criada lá.
# SEM ELA a rota responde 503 e o login por plantões no escala fica desligado.
# Precisa ser IDÊNTICO ao PLANTOES_AUTH_TOKEN do escala.
# Gere com: openssl rand -base64 32
# ESCALA_SSO_TOKEN=

# --- Sessão única via Kairós (provedor de identidade do parque) --------------
# O Kairós emite o cookie kairos_sessao no domínio pai .mnrs.com.br, que chega
# sozinho aqui. Com estas duas variáveis, quem já está logado no Kairós entra
# neste app SEM segunda senha: o servidor pergunta ao Kairós quem é o dono do
# cookie (introspecção, servidor↔servidor) e casa por e-mail com a conta local
# — nenhuma conta é criada, e as roles continuam sendo as daqui.
# SEM ELAS: o caminho fica DESLIGADO e o login local segue exatamente como era.
# Kairós fora do ar = recusa deste caminho (fail-closed), nunca liberação.
# O token nasce no repo kairos: pnpm servico:registrar -- --chave plantoes
# KAIROS_URL=https://kairos.mnrs.com.br
# KAIROS_SERVICO_TOKEN=

# --- Chegada × escala (nível A, agosto/2026) --------------------------------
# Quem registra chegada é comparado com o titular que a escala informa em
# /api/esperados. Divergiu, grava na trilha (audit_logs, action
# "chegada_fora_da_escala") e avisa. NADA é bloqueado neste nível.
#
# O aviso vai para os TELEGRAM_ADMIN_IDS (privado) e, se estas três existirem,
# também para a coordenação no WhatsApp pelo whatsmeow-gw. Sem elas, só Telegram.
# WA_GATEWAY_AUTH é "usuario:senha" (o APP_BASIC_AUTH do gateway).
# WA_GATEWAY_URL=http://127.0.0.1:3080
# WA_GATEWAY_AUTH=
# WA_COORDENACAO_TO=5571XXXXXXXXX,5571YYYYYYYYY
