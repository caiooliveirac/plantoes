#!/usr/bin/env bash
# Pre-push hook: protege o HISTORICO de main (sem force-push). Push direto
# na main e' permitido desde 29/09/2026 — deploy vai direto ao LIVE, sem
# exigir PR. Quem clonar precisa rodar:
#   git config core.hooksPath .githooks
set -euo pipefail

remote="$1"
protected_branch="main"

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "${remote_ref}" != "refs/heads/${protected_branch}" ]]; then
        continue
    fi

    # Bloqueia force-push (detecta se nao e' fast-forward).
    if [[ "${remote_sha}" != "0000000000000000000000000000000000000000" ]]; then
        if ! git merge-base --is-ancestor "${remote_sha}" "${local_sha}" 2>/dev/null; then
            echo "[pre-push] Force-push para '${protected_branch}' bloqueado (nao e' fast-forward)." >&2
            echo "[pre-push] Reescrever historico de main destroi auditoria de deploy. Recuse." >&2
            exit 1
        fi
    fi
done

exit 0
