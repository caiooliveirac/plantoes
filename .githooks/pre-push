#!/usr/bin/env bash
# Pre-push hook: protecao client-side de main, ja' que repo privado free
# nao tem branch protection. Quem clonar precisa rodar:
#   git config core.hooksPath .githooks
set -euo pipefail

remote="$1"
protected_branch="main"

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "${remote_ref}" != "refs/heads/${protected_branch}" ]]; then
        continue
    fi

    # Bloqueia push direto para main: forca uso de PR.
    if [[ -z "${PRE_PUSH_ALLOW_DIRECT_MAIN:-}" ]]; then
        echo "[pre-push] Push direto para '${protected_branch}' bloqueado." >&2
        echo "[pre-push] Use PR: gh pr create --base main --head <branch> && gh pr merge --merge" >&2
        echo "[pre-push] Override de emergencia: PRE_PUSH_ALLOW_DIRECT_MAIN=1 git push ..." >&2
        exit 1
    fi

    # Bloqueia force-push (detecta se nao e' fast-forward).
    if [[ "${remote_sha}" != "0000000000000000000000000000000000000000" ]]; then
        if ! git merge-base --is-ancestor "${remote_sha}" "${local_sha}" 2>/dev/null; then
            echo "[pre-push] Force-push para '${protected_branch}' bloqueado (nao e' fast-forward)." >&2
            echo "[pre-push] Reescrever historico de main destroi auditoria de deploy. Recuse." >&2
            exit 1
        fi
    fi
done

exit 0
